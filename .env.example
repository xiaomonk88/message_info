# Host port mapped to container port 8000 (Docker Compose)
PORT=17500

# JWT secret. Leave empty to auto-generate one into data/secrets/ on first start.
# (or generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=

# Initial admin (only used on first run if no user exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Encryption key for sensitive fields. Leave empty to auto-generate one into data/secrets/.
# Once data is encrypted, NEVER change or lose this key (back up data/secrets/ together with data/).
# (or generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Timezone
TZ=Asia/Shanghai
